# ==============================================================================
# 🔐 CampusSwap Production Environment Variables (.env)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5050

# Security (Replace with a strong random string: openssl rand -base64 32)
JWT_SECRET=dyp_campus_swap_super_secret_jwt_key_2024_prod_auth

# Database URL (Default SQLite file database, or PostgreSQL: postgresql://user:pass@localhost:5432/campusswap)
DATABASE_URL=file:./dev.db

# Allowed College Email Domains (Comma separated)
ALLOWED_EMAIL_DOMAINS=dypvp.edu.in,dit@dypvp.edu.in,college.edu

# Optional Cloudinary / S3 Image Storage (If using cloud file storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
